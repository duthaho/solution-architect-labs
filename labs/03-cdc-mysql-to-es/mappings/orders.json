{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id":          { "type": "long" },
      "customer_id": { "type": "integer" },
      "status":      { "type": "keyword" },
      "amount":      { "type": "scaled_float", "scaling_factor": 100 },
      "note":        { "type": "text" },
      "created_at":  { "type": "date", "format": "epoch_millis" },
      "updated_at":  { "type": "date", "format": "epoch_millis" }
    }
  }
}
